// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  name      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum mealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

model CalorieEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      TimestamptzString @default(now())
  calories  Int
  mealType  mealType @default(BREAKFAST)
  description String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()  
}
