// use prisma-8

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String   @unique
  password  String
  name      String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  profile  UserProfile?
}

enum mealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

enum sex {
  MALE
  FEMALE
}

model CalorieEntry {
  id        Int      @id @default(autoincrement())
  userId    Int
  date      DateString @default(now())
  calories  Int
  mealType  mealType @default(BREAKFAST)
  description String?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()  
}

model UserProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  age       Int?
  height    Float?
  weight    Float?
  sex       sex?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  user      User     @relation(fields: [userId], references: [id])
}
